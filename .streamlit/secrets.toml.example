# Streamlit Secrets Configuration Example
# Copy this file to `.streamlit/secrets.toml` and substitute your actual API key:
# cp .streamlit/secrets.toml.example .streamlit/secrets.toml

# Google Gemini API Key for Explainable AI Agent
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Optional: Override the default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL = "gemini-2.5-flash"

